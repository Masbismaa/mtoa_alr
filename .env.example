# Mode aplikasi: development / production / testing
APP_ENV=development

# Kunci rahasia Flask (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=isi_dengan_hasil_generate

# Koneksi PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:PORT/NAMA_DB
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD_KAMU@localhost:5432/db_mtoa_alr

# Kunci enkripsi kredensial (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=isi_dengan_hasil_generate_fernet

# Folder penyimpanan lampiran (opsional, default: folder uploads di root project)
UPLOAD_FOLDER=............

# SMTP OTP: STARTTLS 587 atau TLS langsung (ssl) 465, sertifikat wajib valid
OTP_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Production: rate limit bersama antar proses; pasang Redis dan batasi akses jaringannya
RATELIMIT_STORAGE_URI=memory://
# Jumlah reverse proxy tepercaya. Tetap 0 bila aplikasi diakses langsung.
TRUSTED_PROXY_COUNT=0

# Default target publik saja. Intranet hanya jika egress server sudah dibatasi oleh operator.
LINK_CHECK_ALLOW_PRIVATE_NETWORKS=false
# Path bundel CA kantor bila memakai sertifikat internal (tidak mematikan verifikasi TLS)
LINK_CHECK_CA_FILE=

# Kuota per akun 500 MiB. Production wajib memakai ClamAV; clamd tidak boleh dibuka ke publik.
UPLOAD_USER_QUOTA_BYTES=524288000
UPLOAD_SCANNER_HOST=
UPLOAD_SCANNER_PORT=3310
